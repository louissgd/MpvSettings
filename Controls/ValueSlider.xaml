<UserControl x:Class="MpvSettings.Controls.ValueSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" MinWidth="224">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- 鼠标：拖动 / 点击轨道快速定位；键盘：方向键 = SmallChange，PageUp/Down = LargeChange -->
        <Slider Grid.Column="0" x:Name="PART_Slider"
                Style="{StaticResource DarkSlider}"
                VerticalAlignment="Center" Margin="0,0,12,0"
                Minimum="{Binding Minimum, ElementName=Root}"
                Maximum="{Binding Maximum, ElementName=Root}"
                SmallChange="{Binding SmallChange, ElementName=Root}"
                LargeChange="{Binding LargeChange, ElementName=Root}"
                TickFrequency="{Binding TickFrequency, ElementName=Root}"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
                IsSnapToTickEnabled="True"
                IsMoveToPointEnabled="True"
                IsSelectionRangeEnabled="True"
                SelectionStart="{Binding Minimum, ElementName=Root}"
                SelectionEnd="{Binding Value, ElementName=Root}" />
        <Border Grid.Column="1" MinWidth="64" Height="30" VerticalAlignment="Center"
                Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="5" Padding="8,0">
            <Grid>
                <!-- IsEditable=False（默认，其他页面）：只读显示，行为与旧版一致 -->
                <TextBlock x:Name="PART_ValueText" Text="{Binding ValueText, ElementName=Root}" FontSize="12"
                           Foreground="{StaticResource TextBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- IsEditable=True（字幕样式弹窗）：可直接键入精确数值，回车/LostFocus 提交 -->
                <TextBox x:Name="PART_ValueBox" Visibility="Collapsed"
                         Text="{Binding ValueText, ElementName=Root, Mode=OneWay}"
                         FontSize="12" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource MonoFont}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         CaretBrush="{StaticResource TextBrush}"
                         LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
