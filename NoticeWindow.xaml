<Window x:Class="MpvSettings.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="提示" Icon="pack://application:,,,/Assets/MpvSettings.ico"
        Width="580" MinWidth="500" MaxHeight="560"
        SizeToContent="Height" MinHeight="230"
        WindowStyle="None" ResizeMode="NoResize"
        SourceInitialized="Window_SourceInitialized"
        Background="{StaticResource AppBrush}"
        FontFamily="Segoe UI, Microsoft YaHei"
        WindowStartupLocation="CenterOwner">

    <!-- 与「写入结果」窗口同一套画法：无系统边框 + 自绘标题栏 + DWM 小圆角。
         导入导出不能用系统 MessageBox（白底系统主题，跟墨绿配色完全不搭）。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="66" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <TextBlock x:Name="Caption" Text="提示" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
                <Button Content="✕" HorizontalAlignment="Right" Width="44" Height="34"
                        FontSize="14" Foreground="{StaticResource WeakTextBrush}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,18,24,14">
            <TextBlock x:Name="Headline" Text="" FontSize="21" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="Summary" Text="" FontSize="13"
                       Foreground="{StaticResource SubTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <Border x:Name="DetailCard" Margin="0,14,0,0"
                    Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,8">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="DetailList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                                           Margin="0,3" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource SidebarBrush}">
            <Grid Margin="24,0,24,0">
                <TextBlock x:Name="FooterHint" Text="" FontSize="11"
                           Foreground="{StaticResource WeakTextBrush}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="330" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource GhostButton}"
                            MinWidth="88" Margin="0,0,10,0" Visibility="Collapsed" Click="Cancel_Click" />
                    <Button x:Name="OkBtn" Content="确定" Style="{StaticResource PrimaryButton}"
                            MinWidth="96" Click="Ok_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
