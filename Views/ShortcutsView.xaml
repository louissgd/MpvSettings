<UserControl x:Class="MpvSettings.Views.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MpvSettings.Controls">
    <UserControl.Resources>
        <!-- 键位 + 状态文字：颜色由状态决定，全部从主题取。
             之前是在 Models\ShortcutData.cs 里 new SolidColorBrush(...) 写死的紫，
             换配色时漏改，所以改用 DataTrigger，C# 只留文本。 -->
        <Style x:Key="ShortcutStateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WeakTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="自定义">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="未绑定">
                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 键位框：可点、可聚焦，聚焦后由键盘捕获控件接管按键 -->
        <Style x:Key="ShortcutKeyBox" TargetType="Button">
            <Setter Property="Width" Value="186" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ActiveBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 清除：仅「自定义」行显示，语义是删掉这一行、恢复默认 -->
        <Style x:Key="ShortcutClear" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="清除这一行，恢复默认键位" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="✕" FontSize="10" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{StaticResource WeakTextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerBgBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="18,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                           Text="一页固定清单，不是全量绑定编辑器。点右侧键位框后直接按组合键录入，Esc 取消；「默认」键来自 mpv 内置弱绑定，「自定义」来自 input.conf 的强绑定。只写你改过的行，其余行原样保留。" />
                <TextBlock FontSize="11" Foreground="{StaticResource WeakTextBrush}" TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Text="改键只叠加不撤销：原默认键仍然可用；清空一个「自定义」行 = 删掉该行、恢复默认（不是禁用按键）。改完需重启 mpv 生效。" />
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Shortcuts.Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:SettingCard Title="{Binding Name}">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="52" Padding="20,8"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Action}" FontSize="13"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding Command}" FontSize="11"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{StaticResource WeakTextBrush}"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Note}" FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding ConflictText}" FontSize="11"
                                                           Foreground="{StaticResource DangerBrush}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding HintText}" FontSize="11"
                                                           Foreground="{StaticResource WarnBrush}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource ShortcutKeyBox}" Tag="{Binding}"
                                                        Click="KeyBox_Click" PreviewKeyDown="KeyBox_PreviewKeyDown"
                                                        LostKeyboardFocus="KeyBox_LostKeyboardFocus">
                                                    <Grid>
                                                        <TextBlock Text="{Binding KeyText}" FontSize="12"
                                                                   Style="{StaticResource ShortcutStateText}"
                                                                   VerticalAlignment="Center" Margin="0,0,46,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding State}" FontSize="10"
                                                                   Style="{StaticResource ShortcutStateText}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Opacity="0.85" />
                                                    </Grid>
                                                </Button>
                                                <Button Style="{StaticResource ShortcutClear}" Tag="{Binding}"
                                                        Click="Clear_Click"
                                                        Visibility="{Binding CanClear, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingCard>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 其他绑定：input.conf 里不属于上面 38 行、但能明确解析的绑定。
             只读，程序永不改写或删除它们（写盘契约第 9 条）；没有这类行时整张卡片不显示。 -->
        <controls:SettingCard Title="{Binding Shortcuts.OthersTitle}"
                              Visibility="{Binding Shortcuts.HasOthers, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Margin="20,8,20,10" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource WeakTextBrush}"
                           Text="input.conf 里不属于上面清单的绑定。本程序只读不写，改它们请手工编辑 input.conf。" />
                <ItemsControl ItemsSource="{Binding Shortcuts.Others}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="40" Padding="20,6"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding KeyText}" FontSize="12"
                                               Foreground="{StaticResource SubTextBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Command}" FontSize="11"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource WeakTextBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </controls:SettingCard>

    </StackPanel>
</UserControl>
