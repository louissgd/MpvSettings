<UserControl x:Class="MpvSettings.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MpvSettings.Controls">
    <StackPanel>

        <controls:SettingCard Title="MPV 简单设置">
            <StackPanel Margin="20,14">
                <TextBlock Text="MPV 简单设置 1.0.9" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="常用设置都在这里：播放、画面、音频、截图、快捷键。改完点「应用」或「确定」保存；想让改动生效，点左下角「打开 MPV 播放器」重启播放器即可。" />
                <TextBlock FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="配置的备份与恢复也在本页，默认保存到桌面\MyMPC-MPV-备份。" />
            </StackPanel>
        </controls:SettingCard>

        <!-- 导入导出入口固定在关于页。固定文件夹覆盖式，只保留一份。 -->
        <controls:SettingCard Title="配置备份 / 恢复">
            <StackPanel Margin="20,14">
                <TextBlock Text="备份文件夹（固定覆盖 · 只保留一份）"
                           FontSize="11" Foreground="{StaticResource WeakTextBrush}" />
                <TextBlock x:Name="BackupDirText" Text="—" FontSize="12"
                           Foreground="{StaticResource SubTextBrush}" FontFamily="{StaticResource MonoFont}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="导出配置" Style="{StaticResource PrimaryButton}" MinWidth="112"
                            Click="BackupExport_Click"
                            ToolTip="把当前设置保存到上面的文件夹，覆盖上一次备份" />
                    <Button Content="导入配置" Style="{StaticResource GhostButton}" MinWidth="112" Margin="10,0,0,0"
                            Click="BackupImport_Click"
                            ToolTip="先检查备份是否完整，再把设置写回来；导入前会自动把当前配置另存一份" />
                    <Button Content="更改文件夹" Style="{StaticResource GhostButton}" MinWidth="104" Margin="10,0,0,0"
                            Click="BackupPick_Click" ToolTip="选过的文件夹会记住，默认导出到桌面\MyMPC-MPV-备份" />
                    <Button Content="打开文件夹" Style="{StaticResource GhostButton}" MinWidth="104" Margin="10,0,0,0"
                            Click="BackupOpen_Click" ToolTip="在资源管理器里查看备份文件" />
                </StackPanel>
                <TextBlock x:Name="BackupStatus" FontSize="12" Margin="0,12,0,0"
                           Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                           Text="就绪 · 导出会覆盖上一次备份，只保留一份" />
                <TextBlock FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="导出把当前设置原样存进上面的文件夹；导入只覆盖本程序管理的设置，你自己加的快捷键和菜单条目都会保留。导入前会自动把当前配置另存到 _before_import，同样只留一份，需要时可以找回来。" />
                <TextBlock FontSize="12" Foreground="{StaticResource WeakTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="备份会检查文件是否完整，有一处对不上就中止，不会改动当前设置。第三方脚本和截图保存位置不参与备份，专属音效滤镜始终保留。导入完成后请用左下角「打开 MPV 播放器」重启生效。" />
            </StackPanel>
        </controls:SettingCard>

        <controls:SettingCard Title="当前配置（只读）">
            <StackPanel Margin="20,14">
                <TextBlock Text="配置来源" FontSize="11" Foreground="{StaticResource WeakTextBrush}" />
                <TextBlock Text="{Binding ConfigSourceText}" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                           FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,4,0,10" />
                <TextBlock Text="MPV 程序" FontSize="11" Foreground="{StaticResource WeakTextBrush}" />
                <TextBlock Text="{Binding MpvExeText}" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                           FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,4,0,10" />
                <TextBlock Text="读取时间" FontSize="11" Foreground="{StaticResource WeakTextBrush}" />
                <TextBlock Text="{Binding SnapshotText}" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,10" />
                <TextBlock Text="音效状态" FontSize="11" Foreground="{StaticResource WeakTextBrush}" />
                <TextBlock Text="{Binding BassMaxRegStatus}" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,10" />
                <TextBlock Text="比特流直通" FontSize="11" Foreground="{StaticResource WeakTextBrush}" />
                <TextBlock Text="{Binding SpdifText}" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </controls:SettingCard>

    </StackPanel>
</UserControl>
