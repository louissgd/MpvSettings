<!-- 最小尺寸 880x540 —— 由内容实测得出，不是拍的：
     顶部工具行的「配置标签 + 搜索框 + 全部重置 + 重置页面」在 Auto 列里合计约 490 DIP，
     加导航 56、页面 padding 48、标题区留 220 后约 820 是硬下界（760 时标题区已被挤扁、
     提示文字只剩半句）；取 880x540 留 60x40 余量。逐页渲染验证见
     `_verify/min/shot880_*.png` 与 `MpvSettings_1.0.4_改动记录.md`。
     ⚠ 光写在这两个属性上没用：本窗在 WM_GETMINMAXINFO 里接管了消息（handled=true），
     WPF 自己把 MinWidth/MinHeight 换算成 ptMinTrackSize 的那段被整段跳过，
     修复前实测 ptMinTrackSize = 0x0（能拖到任意小）。换算现在补在
     MainWindow.xaml.cs 的 ApplyWorkAreaBounds() 里，改这里的数值即生效。 -->
<Window x:Class="MpvSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MPV 简单设置" Icon="pack://application:,,,/Assets/MpvSettings.ico"
        Height="680" Width="1000" MinHeight="540" MinWidth="880"
        WindowStyle="None" ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        SourceInitialized="Window_SourceInitialized"
        Background="{StaticResource AppBrush}"
        FontFamily="Segoe UI, Microsoft YaHei"
        WindowStartupLocation="CenterScreen">

    <!-- 接管非客户区：WindowStyle=None 时 WPF 默认保留约 7px 系统 resize 边框，
         DWM 会在窗口顶部画一条浅灰细条（#4A5459）。GlassFrameThickness=0 去掉边框，
         ResizeBorderThickness 仍保留四边 / 四角的拉伸命中区域。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- 标题栏按钮：自绘三个（最小化 / 最大化-还原 / 关闭）。
         WindowStyle=None 时系统按钮全部消失，必须自己画；不画最大化就会「点了没反应」。 -->
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource WeakTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ActiveBgBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerBgBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 34px -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="MPV 简单设置" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="VersionLabel" Text="" FontSize="11"
                               Foreground="{StaticResource WeakTextBrush}" Margin="10,1,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="最小化">
                        <Path Data="M 0,0 L 10,0" Width="10" Height="1" Stretch="None" StrokeThickness="1.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}"
                            Click="MaximizeRestore_Click" ToolTip="最大化">
                        <Grid Width="10" Height="10">
                            <Path x:Name="IconMax" Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                                  Stretch="None" StrokeThickness="1.1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <Path x:Name="IconRestore" Data="M 3.5,0 L 10,0 L 10,6.5 M 0,3.5 L 6.5,3.5 L 6.5,10 L 0,10 Z"
                                  Stretch="None" StrokeThickness="1.1" Visibility="Collapsed"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="关闭">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Width="9" Height="9" Stretch="None" StrokeThickness="1.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：56px 图标导航 + 内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                        <RadioButton x:Name="NavPlay" Tag="播放" ToolTip="播放"
                                     Style="{StaticResource NavRadio}" Checked="Nav_Checked">
                            <Path Data="M 3,2 L 13,8 L 3,14 Z" Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                        </RadioButton>
                        <RadioButton x:Name="NavVideo" Tag="画面" ToolTip="画面"
                                     Style="{StaticResource NavRadio}" Checked="Nav_Checked">
                            <Path Data="M 2,3 L 14,3 L 14,12 L 2,12 Z M 6,15 L 10,15 M 8,12 L 8,15"
                                  Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                        </RadioButton>
                        <RadioButton x:Name="NavAudio" Tag="音频" ToolTip="音频"
                                     Style="{StaticResource NavRadio}" Checked="Nav_Checked">
                            <Path Data="M 2,6 L 6,6 L 10,2 L 10,14 L 6,10 L 2,10 Z M 12,5 A 4,4 0 0 1 12,11"
                                  Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                        </RadioButton>
                        <RadioButton x:Name="NavShot" Tag="截图" ToolTip="截图"
                                     Style="{StaticResource NavRadio}" Checked="Nav_Checked">
                            <Path Data="M 2,5 L 5,5 L 6,3 L 10,3 L 11,5 L 14,5 L 14,14 L 2,14 Z M 8,8 A 2.2,2.2 0 1 0 8,12.4 A 2.2,2.2 0 1 0 8,8"
                                  Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                        </RadioButton>
                        <RadioButton x:Name="NavKeys" Tag="快捷键" ToolTip="快捷键"
                                     Style="{StaticResource NavRadio}" Checked="Nav_Checked">
                            <Path Data="M 1,4 L 15,4 L 15,12 L 1,12 Z M 4,7 L 12,7 M 4,10 L 12,10"
                                  Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                        </RadioButton>
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="10,10,10,10" />
                    </StackPanel>
                    <RadioButton x:Name="NavAbout" DockPanel.Dock="Bottom" Tag="关于" ToolTip="关于"
                                 Style="{StaticResource NavRadio}" Checked="Nav_Checked" Margin="0,0,0,10">
                        <Path Data="M 8,1 A 7,7 0 1 0 8,15 A 7,7 0 1 0 8,1 M 8,7 L 8,11 M 8,4.5 L 8,4.5"
                              Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                    </RadioButton>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="84" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶部工具行 -->
                <Border Grid.Row="0" Padding="24,14,24,8">
                    <!-- 两列：左栏吃剩余宽度（长标题按…省略），右栏 Auto 固定宽度。
                         不要给左栏 Auto——三列 Auto 时右侧按钮组会把 Grid 挤宽，
                         最右的「重置页面」会被布局裁掉右半条边框（实测只丢右边那一条）。 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="PageTitle" Text="播放" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PageHint" Text="常规播放、字幕与纯音频行为" FontSize="12"
                                       Foreground="{StaticResource WeakTextBrush}" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                    HorizontalAlignment="Right" Height="34">
                            <Border Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="ConfigLabel" Text="配置：mpv.conf" FontSize="11"
                                           MaxWidth="240" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource SubTextBrush}" />
                            </Border>
                            <Grid Width="150" Height="32" Margin="0,0,8,0" VerticalAlignment="Top">
                                <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}"
                                         Width="150" TextChanged="SearchBox_TextChanged"
                                         ToolTip="按标题或说明文字过滤当前页的设置行" />
                                <TextBlock x:Name="SearchPlaceholder" Text="搜索设置项" FontSize="12"
                                           Foreground="{StaticResource WeakTextBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           IsHitTestVisible="False" />
                            </Grid>
                            <Button x:Name="ResetAllBtn" Content="全部重置" Style="{StaticResource GhostButton}"
                                    MinWidth="78" Margin="0,0,8,0" Click="ResetAll_Click"
                                    ToolTip="所有页面恢复出厂默认，保存后才写入" />
                            <Button x:Name="ResetPageBtn" Content="重置页面" Style="{StaticResource GhostButton}"
                                    MinWidth="78" Click="ResetPage_Click"
                                    ToolTip="仅当前页恢复出厂默认，保存后才写入" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Margin 右侧 8：WindowChrome 的 ResizeBorderThickness=6 会占用窗口最右侧
                     6px 作为拉伸命中区，滚动条贴着边会整条点不到、拖不动，必须留出这段空隙。 -->
                <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="24,4,24,24"
                              Margin="0,0,8,0">
                    <ContentControl x:Name="PageHost" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource SidebarBrush}">
            <Grid Margin="24,0,24,0">
                <!-- 右侧「应用 / 确定 / 取消」保持原来的位置（页脚 68px 里垂直居中，距底 17px），
                     一个像素都不动。左侧原来是「按钮行 + 两行小字」的纵向 StackPanel，按钮落在
                     第一行所以比右侧高一截；现在改成横向 StackPanel + 按钮自身 Center：
                     左右两栏都 Center 于同一个 68px，按钮中心必然落在同一条水平线上。
                     三行小字挪进按钮右侧的竖排里，不丢信息也不挤压按钮。 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <!-- GhostButton 模板的 ContentPresenter 没有绑 Padding，设 Padding 无效；
                         改全局样式又会把顶部工具行撑宽（「重置页面」刚修好被裁的问题）。
                         所以只给这一个按钮加 MinWidth，让文字左右各留约 16px。 -->
                    <Button x:Name="RestartMpvBtn" Content="打开 MPV 播放器" Style="{StaticResource GhostButton}"
                            MinWidth="132" Click="RestartMpv_Click" VerticalAlignment="Center"
                            ToolTip="关掉所有正在运行的 MPV 后重新打开一个空闲窗口；刚保存的设置重启后才生效。只影响 MPV，不动 MPC-HC / PotPlayer。" />
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="关掉已开的 MPV 再重开 · 写入的配置重启后生效"
                                   FontSize="11" Foreground="{StaticResource WeakTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ConfigSourceText}" FontSize="10"
                                   Foreground="{StaticResource WeakTextBrush}" Opacity="0.8"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding SnapshotText}" FontSize="10"
                                   Foreground="{StaticResource WeakTextBrush}" Opacity="0.8"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ApplyBtn" Content="应用" Style="{StaticResource GhostButton}"
                            Margin="0,0,10,0" Click="Apply_Click"
                            ToolTip="保存改动但不关闭窗口；没有新改动时不会重复写入" />
                    <Button x:Name="OkBtn" Content="确定" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,10,0" Click="Ok_Click"
                            ToolTip="只保存改动过的设置，保存成功后关闭窗口" />
                    <Button Content="取消" Style="{StaticResource GhostButton}" Click="Cancel_Click"
                            ToolTip="放弃改动并关闭，不写入任何文件" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 配置不可用：整窗禁用并显示原因（照抄 MpvUsable 逻辑） -->
        <Border x:Name="DisabledOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="99"
                Visibility="Collapsed" Background="{StaticResource OverlayBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                <TextBlock Text="MPV 简单设置不可用" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="DisabledReason" Text="" FontSize="13"
                           Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="请确认安装时已勾选 MPV，或重新安装后重试。"
                           FontSize="12" Foreground="{StaticResource WeakTextBrush}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
